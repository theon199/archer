# ==============================================================================
# Archer V1 - Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Application & Server
ARCHER_ENV=development
ARCHER_HOST=127.0.0.1
ARCHER_PORT=8000
ARCHER_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ARCHER_DATABASE_URL=sqlite+aiosqlite:///./data/archer.db

# ------------------------------------------------------------------------------
# Model Inference Providers
# Default mode: local (utilizing NVIDIA DGX Spark hardware)
# Options: local-ollama | local-sglang | anthropic | gemini | openai
# ------------------------------------------------------------------------------
ARCHER_MODEL_PROVIDER=local-ollama

# Local Ollama on Spark (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Local SGLang Router on Spark (default port 8080)
SGLANG_BASE_URL=http://localhost:8080/v1
SGLANG_MODEL=qwen3.8-27b

# Optional Cloud Providers (explicit opt-in)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Plugins & External Integrations
# ------------------------------------------------------------------------------
# Brave Search API (optional, for web citations)
BRAVE_SEARCH_API_KEY=

# Allowed filesystem root for Approved Files plugin (defaults to workspace)
APPROVED_FILES_ROOT=/home/sri/projects/archer/data/approved_files

# ==============================================================================
# Archer V1 - Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Application & Server
ARCHER_ENV=development
ARCHER_HOST=127.0.0.1
ARCHER_PORT=8000
ARCHER_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ARCHER_DATABASE_URL=sqlite+aiosqlite:///./data/archer.db

# ------------------------------------------------------------------------------
# Model Inference Providers
# Default mode: local (utilizing NVIDIA DGX Spark hardware)
# Supported inference: local-ollama | local-sglang. Cloud inference is disabled.
# ------------------------------------------------------------------------------
ARCHER_MODEL_PROVIDER=local-ollama

# Local Ollama on Spark (default port 11434)
ARCHER_OLLAMA_BASE_URL=http://localhost:11434
ARCHER_OLLAMA_MODEL=gemma4:26b
ARCHER_OLLAMA_NUM_CTX=4096
ARCHER_OLLAMA_TEMPERATURE=0.7

# Local SGLang Router on Spark (default port 8080)
ARCHER_SGLANG_BASE_URL=http://localhost:8080/v1
ARCHER_SGLANG_MODEL=qwen3.8-27b

# Legacy cloud settings (inference disabled; these do not enable cloud use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# Plugins & External Integrations
# ------------------------------------------------------------------------------
# Tavily search reads an owner-only key file; do not put the key itself here.
# ARCHER_TAVILY_API_KEY_FILE=/home/sri/.config/archer/tavily-api-key

# Allowed filesystem root for Approved Files plugin (defaults to workspace)
APPROVED_FILES_ROOT=/home/sri/projects/archer/data/approved_files

# Native release paths and optional Ollama artifact pin (see docs/private-deployment.md)
# ARCHER_DATA_DIR=/absolute/private-runtime/data
# ARCHER_STATIC_DIR=/absolute/release/frontend/dist
# ARCHER_EXPECTED_MODEL_DIGEST=<reviewed-local-digest>

# Optional owned 0600 reviewed mapping file; absent means no MCP connectors
# ARCHER_MCP_CONFIG_PATH=/absolute/private/mcp.json
